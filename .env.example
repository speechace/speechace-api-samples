# Copy this file to .env and fill in your credentials
# endpoint below US West (see https://api-docs.speechace.com/getting-started/pre-requisites/api-regions-and-endpoints)
SPEECHACE_API_KEY=your_api_key_here
SPEECHACE_API_ENDPOINT=https://api.speechace.co

# Set to 1 to run integration tests against the real API
SPEECHACE_RUN_INTEGRATION=1

# Optional: override the user_id sent to the API
SPEECHACE_USER_ID=github_s001
